# Copy to .env.local or set these in the process environment. Do not commit keys.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional source credentials; public endpoints can be used without them where supported.
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=
NCBI_EMAIL=
UNPAYWALL_EMAIL=

# Optional: absolute local library root, otherwise .research-base/library.
RESEARCH_BASE_LIBRARY=
